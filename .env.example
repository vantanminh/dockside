# dockside-server server configuration (copy to .env; never commit .env)
DOCKSIDE_BIND_ADDR=127.0.0.1:7420
DOCKSIDE_DATA_DIR=./data
DOCKSIDE_CONFIG=./dockside.toml

# Required if binding to a non-loopback address (e.g. 0.0.0.0:7420 in a container)
# DOCKSIDE_AUTH_TOKEN=replace-with-long-random-token

# Optional Cloudflare R2 L2 blob backend (local disk remains L1 cache)
# DOCKSIDE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DOCKSIDE_R2_REGION=auto
# DOCKSIDE_R2_BUCKET=dockside-cas
# DOCKSIDE_R2_PREFIX=cas/v1
# DOCKSIDE_R2_ACCESS_KEY_ID=
# DOCKSIDE_R2_SECRET_ACCESS_KEY=

# Optional 1-way Git mirror directory (async backup on every landed revision)
# DOCKSIDE_GIT_MIRROR_DIR=./data/git-mirror

# CLI defaults
DOCKSIDE_URL=http://127.0.0.1:7420
# DOCKSIDE_TOKEN=
DOCKSIDE_WORKSPACES_DIR=./data/workspaces
DOCKSIDE_VERIFY_WORKDIR=./data/verify-work
# true = real verify gate (cargo/pnpm). Needed for sensitive paths (migrations/auth/infra) to land.
DOCKSIDE_RUN_VERIFY=false

# Release/rollback tooling (only needed for the matching target kinds; see README)
# RUDDER_URL=
# RUDDER_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
